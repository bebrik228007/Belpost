<Window x:Class="Belpost.Auth.Register"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Регистрация пользователя"
        Height="400" Width="500"
        WindowStartupLocation="CenterScreen"
        Background="#f0f4ff" Loaded="Minute_Timer" MouseMove="Register_MouseMove" MouseDown="Register_MouseDown" KeyDown="Register_KeyDown">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <TextBlock Text="Регистрация нового пользователя"
                   FontSize="20" FontWeight="Bold"
                   HorizontalAlignment="Center" Margin="0,0,0,20"/>

        <!-- Логин -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,5">
            <TextBlock Text="Логин:" Width="120" VerticalAlignment="Center"/>
            <TextBox x:Name="UsernameBox" Width="250"/>
        </StackPanel>

        <!-- Роль -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,5">
            <TextBlock Text="Роль:" Width="120" VerticalAlignment="Center"/>
            <ComboBox x:Name="RoleBox" Width="250">
                <ComboBoxItem Content="Начальник отделения почтовой связи"/>
                <ComboBoxItem Content="Оператор связи"/>
            </ComboBox>
        </StackPanel>

        <!-- Пароль -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,5">
            <TextBlock Text="Пароль:" Width="120" VerticalAlignment="Center"/>
            <PasswordBox x:Name="PasswordBox" Width="250"/>
        </StackPanel>

        <!-- Подтверждение пароля -->
        <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0,5">
            <TextBlock Text="Пароль ещё раз   :" Width="120" VerticalAlignment="Center"/>
            <PasswordBox x:Name="ConfirmPasswordBox" Width="250"/>
        </StackPanel>

        <!-- Подсказки -->
        <TextBlock Grid.Row="5" Text="Пароль должен содержать: 
- минимум 8 символов
- строчные и прописные буквы русского и английского алфавита
- хотя бы одну цифру."
                   Foreground="DarkRed" Margin="0,10,0,10" TextWrapping="Wrap"/>

        <!-- Кнопки -->
        <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20">
            <Button x:Name="RegisterButton" Content="Зарегистрировать" Width="150" Margin="10" Click="RegisterButton_Click" Height="50"/>
            <Button x:Name="CancelButton" Content="Отмена" Width="100" Margin="10" Click="CancelButton_Click" Height="50"/>
        </StackPanel>
    </Grid>
</Window>
