<Window x:Class="Belpost.Auth.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Белпочта - Авторизация"
        Height="420" Width="640"
        WindowStartupLocation="CenterScreen"
        Background="#ffffff"
        FontFamily="Segoe UI">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Шапка -->
        <Border Grid.Row="0" Background="#0047AB" Padding="15">
            <TextBlock Text="Белпочта"
                       Foreground="White"
                       FontSize="26"
                       FontWeight="Bold"
                       HorizontalAlignment="Center"/>
        </Border>

        <!-- Форма авторизации -->
        <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" Width="300">
            <TextBlock Text="Логин:" FontSize="14" Foreground="#0047AB" Margin="0,0,0,5"/>
            <TextBox x:Name="LoginBox"
                     Height="32"
                     FontSize="14"
                     Margin="0,0,0,15"
                     Padding="5"
                     BorderBrush="#0047AB"
                     BorderThickness="1"/>

            <TextBlock Text="Пароль:" FontSize="14" Foreground="#0047AB" Margin="0,0,0,5"/>

            <!-- Контейнер для пароля -->
            <Grid>
                <PasswordBox x:Name="PasswordBox"
                             Height="32"
                             FontSize="14"
                             Padding="5"
                             BorderBrush="#0047AB"
                             BorderThickness="1"
                             Visibility="Visible"/>

                <TextBox x:Name="VisibleTextBox"
                         Height="32"
                         FontSize="14"
                         Padding="5"
                         BorderBrush="#0047AB"
                         BorderThickness="1"
                         Visibility="Collapsed"/>
            </Grid>

            <CheckBox x:Name="CheckBox1"
                      Content="Показать пароль"
                      Margin="0,10,0,25"
                      Checked="CheckBox1_Checked"
                      Unchecked="CheckBox1_UnChecked"
                      Cursor = "Hand" 
                      />

            <Button Content="Войти"
                    Width="140" Height="40"
                    Background="#FFD700"
                    Foreground="#0047AB"
                    FontWeight="Bold"
                    Click="Login_Click"
                    HorizontalAlignment="Center"
                    Cursor="Hand"
                    Margin="0,0,0,10"/>

            <!-- Новая надпись -->
            <TextBlock Text="Не зарегистрированы?"
                       FontSize="12"
                       Foreground="Gray"
                       HorizontalAlignment="Center"
                       Cursor="Hand" MouseLeftButtonDown="Register_Click"/>
        </StackPanel>

        <!-- Подвал -->
        <Border Grid.Row="2" Background="#0047AB" Padding="10">
            <TextBlock Text="© Белпочта, 2026"
                       Foreground="White"
                       FontSize="12"
                       HorizontalAlignment="Center"/>
        </Border>
        <TextBox x:Name="TimeBox" HorizontalAlignment="Left" BorderBrush="White" Height="21" Margin="381,182,0,0" Grid.Row="1" TextWrapping="Wrap" VerticalAlignment="Top" Width="51"/>
    </Grid>
</Window>
