<Window x:Class="Belpost.Auth.Password_Change"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Смена пароля" Height="300" Width="400"
        WindowStartupLocation="CenterScreen" Loaded="Minute_Timer" KeyDown="Register_KeyDown" MouseDown="Register_MouseDown" MouseMove="Register_MouseMove">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Старый пароль -->
        <TextBlock Text="Старый пароль:" Grid.Row="0" Margin="0,0,0,5"/>
        <PasswordBox x:Name="OldPasswordBox" Grid.Row="0" Margin="120,0,0,5" Width="200"/>

        <!-- Новый пароль -->
        <TextBlock Text="Новый пароль:" Grid.Row="1" Margin="0,10,0,5"/>
        <PasswordBox x:Name="NewPasswordBox" Grid.Row="1" Margin="120,10,0,5" Width="200"/>

        <!-- Подтверждение -->
        <TextBlock Text="Подтверждение:" Grid.Row="2" Margin="0,10,0,5"/>
        <PasswordBox x:Name="ConfirmPasswordBox" Grid.Row="2" Margin="120,10,0,5" Width="200"/>

        <!-- Сообщение об ошибке -->
        <TextBlock x:Name="ErrorText" Grid.Row="3" Foreground="Red" Margin="0,10,0,5"/>

        <!-- Кнопки -->
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="Сменить пароль" Width="120" Margin="0,0,10,0" Click="ChangePassword_Click"/>
            <Button Content="Отмена" Width="80" Click="Cancel_Click"/>
        </StackPanel>
    </Grid>
</Window>
